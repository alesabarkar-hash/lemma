/* LEMMA UX v2.0 — Phase 1. Educational data and scoring are read-only here. */
(function(){
"use strict";
const legacyGo=window.go;
const legacyOpenTopic=window.openTopic;
const legacyOpenAcademy=window.openAcademy;
const legacyRender=window.render;
const UX={screen:"home",topic:null};

document.body.classList.add("uxv2-active");

function h(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function topicList2(){return (TOPICS[2]||[]).filter(t=>t.ready&&LESSONS[t.id])}
function isDone(id){return !!(PROG[id]&&PROG[id].done)}
function currentTopicId(){
  const a=topicList2();
  const fromSaved=SAVED&&SAVED.topic&&LESSONS[SAVED.topic]&&!isDone(SAVED.topic)?SAVED.topic:null;
  return fromSaved||(a.find(t=>!isDone(t.id))||a[a.length-1]||{}).id||null;
}
function topicProgress(id){
  const T=LESSONS[id]; if(!T)return{done:0,total:1};
  if(T.subLessons){
    const ids=T.subLessons||[];
    return {done:ids.filter(isDone).length+(T.checkId&&isDone(T.checkId)?1:0),total:ids.length+(T.checkId?1:0)};
  }
  return {done:isDone(id)?1:0,total:1};
}
function mission(){
  const topicId=currentTopicId(),T=LESSONS[topicId]; if(!T)return null;
  if(SAVED&&SAVED.topic===topicId){
    const target=savedTarget();
    if(target&&LESSONS[target]){
      const idx=T.subLessons?T.subLessons.indexOf(target):-1;
      return {topicId,lessonId:target,title:T.name,stage:target===T.checkId?"Проверка темы":idx>=0?`Урок ${idx+1}`:"Продолжить",
              detail:LESSONS[target].name,saved:true,time:6,isCheck:target===T.checkId};
    }
  }
  if(T.subLessons){
    const idx=T.subLessons.findIndex(id=>!isDone(id));
    if(idx>=0)return {topicId,lessonId:T.subLessons[idx],title:T.name,stage:`Урок ${idx+1}`,detail:LESSONS[T.subLessons[idx]].name,time:8};
    if(T.checkId&&!isDone(T.checkId))return {topicId,lessonId:T.checkId,title:T.name,stage:"Проверка темы",detail:"10 коротких заданий",time:7,isCheck:true};
  }
  return {topicId,lessonId:topicId,title:T.name,stage:T.areaNames?"Повторение":"Урок",detail:T.sub||"",time:10,review:!!T.areaNames};
}
function hideLegacy(){
  SCREENS.forEach(s=>{const el=document.getElementById("s-"+s);if(el)el.classList.add("hidden")});
  document.body.classList.remove("landing","lesson-mode");
}
function showRoot(screen){
  UX.screen=screen;
  const root=document.getElementById("uxv2-root"); root.classList.add("ux-on");
  root.querySelectorAll(".ux-screen").forEach(x=>x.classList.toggle("ux-on",x.id==="ux-"+screen));
  syncNav(screen==="home"?"home":screen==="path"?"path":"");
  window.scrollTo(0,0);
}
function hideRoot(){const root=document.getElementById("uxv2-root");if(root)root.classList.remove("ux-on")}
function syncNav(which){document.querySelectorAll(".ux-nav button").forEach(b=>b.classList.toggle("ux-on",b.dataset.ux===which))}
function startMission(m){
  if(!m)return;
  if(m.saved&&SAVED){resumeSaved();return}
  if(m.isCheck){showCheckIntro(m.topicId,m.lessonId);return}
  L=LESSONS[m.lessonId];curTopic=m.topicId;stage=L.theory.length?"theory":"practice";step=0;resetRun();openLesson();
}
function openLessonUX(topicId,lid){
  const T=LESSONS[topicId];
  if(T&&lid===T.checkId){showCheckIntro(topicId,lid);return}
  L=LESSONS[lid];curTopic=topicId;stage=L.theory.length?"theory":"practice";step=0;resetRun();openLesson();
}
function showCheckIntro(topicId,lid){
  hideLegacy();showRoot("check");
  const T=LESSONS[topicId],C=LESSONS[lid];
  document.getElementById("ux-check").innerHTML=`<div class="ux-check-intro">
    <button class="ux-back" onclick="uxTopic('${topicId}')">← Тема</button>
    <div class="ux-check-icon">✦</div><div class="ux-kicker">${h(T.name)}</div>
    <h2>Проверим тему?</h2><p>${C.tasks.length} коротких заданий. Результат покажет, что уже получается уверенно и что стоит повторить.</p>
    <button class="ux-primary" style="max-width:270px;margin-top:16px" onclick="uxBeginCheck('${topicId}','${lid}')">НАЧАТЬ ПРОВЕРКУ →</button></div>`;
}
window.uxBeginCheck=function(topicId,lid){L=LESSONS[lid];curTopic=topicId;stage="practice";step=0;resetRun();openLesson()};
window.uxExitLesson=function(){
  const total=stage==="theory"?L.theory.length:L.tasks.length;
  const temp=L.isTrainer||L.isDrill||L.isFix;
  const leave=function(){
    if(!temp&&step>0&&step<total){SAVED={topic:curTopic,lessonId:L.id,stage:stage,step:step,score:score,mistakes:mistakes};saveAll();}
    if(L.isTrainer){renderPathUX();return;}
    if(L.isDrill){go("drill");return;}
    